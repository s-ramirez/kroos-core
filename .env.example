# Copy to $KROOS_HOME/.env (default ~/.kroos/.env). kroos never reads a .env
# from the current directory or the code checkout.

# LLM providers: chatgpt (run `kroos login`) and omlx. Either works alone;
# the other is the fallback.
KROOS_PROVIDER=chatgpt
# KROOS_MODEL=                      # override for the selected provider
# KROOS_CHATGPT_MODEL=                # empty = first model in your account's catalog
# KROOS_OMLX_MODEL=                 # empty = first model the server lists
# KROOS_FALLBACK=true
KROOS_OMLX_URL=http://your-omlx-host:8000
KROOS_OMLX_API_KEY=
# KROOS_LOG_DIR=~/.kroos/logs
KROOS_WEBUI_PORT=8420

# iMessage via BlueBubbles (ServerURL + Password must be set to enable)
# Set BLUEBUBBLES_ENABLED=false to force-disable even if creds are present.
# BLUEBUBBLES_ENABLED=true
# BLUEBUBBLES_SERVER_URL=http://192.168.1.x:1234
# BLUEBUBBLES_PASSWORD=your-bluebubbles-password
# BLUEBUBBLES_WEBHOOK_HOST=127.0.0.1
# BLUEBUBBLES_WEBHOOK_PORT=8421
# BLUEBUBBLES_WEBHOOK_PATH=/bluebubbles
# BLUEBUBBLES_ALLOWED_USERS=+15551234567,you@example.com
# BLUEBUBBLES_GROUP_TAG=@kroos
# BLUEBUBBLES_WEBHOOK_URL=http://localhost:8421/bluebubbles
# BLUEBUBBLES_REGISTER_WEBHOOK=true
# BLUEBUBBLES_READ_RECEIPTS=true
# BLUEBUBBLES_HOME_CHANNEL=any;-;+15551234567

# Discord (Token must be set to enable)
# Set DISCORD_ENABLED=false to force-disable even if a token is present.
# DISCORD_ENABLED=true
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_ALLOWED_USERS=123456789012345678,234567890123456789
# DISCORD_GUILD_TAG=@kroos
# DISCORD_ALLOW_ALL_USERS=false
# DISCORD_HOME_CHANNEL=123456789012345678

# Telegram (Token must be set to enable; uses long-polling, no public URL needed)
# Set TELEGRAM_ENABLED=false to force-disable even if a token is present.
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# TELEGRAM_ALLOWED_USERS=123456789
# TELEGRAM_GROUP_TAG=@kroos
# TELEGRAM_ALLOW_ALL_USERS=false
# TELEGRAM_HOME_CHANNEL=-1001234567890
# TELEGRAM_HOME_CHANNEL_THREAD_ID=1

# Attachments (all channels)
# KROOS_ATTACHMENT_DIR=/tmp/kroos-attachments
# Inline images as vision input; set false for non-vision models.
# KROOS_IMAGE_INPUT=true
