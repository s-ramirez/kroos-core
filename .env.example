KROOS_BASE_URL=https://api.openai.com
KROOS_MODEL=gpt-5.4
KROOS_API_KEY=
KROOS_LOG_DIR=.kroos/logs
KROOS_WEBUI_PORT=8420

OPENAI_API_KEY=your-openai-api-key
OMLX_API_KEY=

# iMessage via BlueBubbles (ServerURL + Password must be set to enable)
# Set KROOS_IMESSAGE_ENABLED=false to force-disable even if creds are present.
# KROOS_IMESSAGE_ENABLED=true
# KROOS_IMESSAGE_SERVER_URL=http://192.168.1.x:1234
# KROOS_IMESSAGE_PASSWORD=your-bluebubbles-password
# KROOS_IMESSAGE_WEBHOOK_HOST=127.0.0.1
# KROOS_IMESSAGE_WEBHOOK_PORT=8421
# KROOS_IMESSAGE_WEBHOOK_PATH=/bluebubbles
# KROOS_IMESSAGE_OWNER_HANDLES=+15551234567,you@example.com
# KROOS_IMESSAGE_GROUP_TAG=@kroos
# KROOS_IMESSAGE_WEBHOOK_URL=http://localhost:8421/bluebubbles
# KROOS_IMESSAGE_REGISTER_WEBHOOK=true
# KROOS_IMESSAGE_READ_RECEIPTS=true

# Discord (Token must be set to enable)
# Set KROOS_DISCORD_ENABLED=false to force-disable even if a token is present.
# KROOS_DISCORD_ENABLED=true
# KROOS_DISCORD_TOKEN=your-discord-bot-token
# KROOS_DISCORD_OWNER_IDS=123456789012345678,234567890123456789
# KROOS_DISCORD_GUILD_TAG=@kroos

# Telegram (Token must be set to enable; uses long-polling, no public URL needed)
# Set KROOS_TELEGRAM_ENABLED=false to force-disable even if a token is present.
# KROOS_TELEGRAM_ENABLED=true
# KROOS_TELEGRAM_TOKEN=123456:ABC-your-botfather-token
# KROOS_TELEGRAM_OWNER_IDS=123456789
# KROOS_TELEGRAM_GROUP_TAG=@kroos

# Attachments (all channels)
# KROOS_ATTACHMENT_DIR=/tmp/kroos-attachments
# Inline images as vision input; set false for non-vision models.
# KROOS_IMAGE_INPUT=true
